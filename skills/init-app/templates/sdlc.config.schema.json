{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostitech.co.nz/schemas/sdlc.config.v1.json",
  "title": "SDLC skills configuration (contract version 1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["app", "workspace"], "default": "app", "description": "app: a repository that builds and ships code; workspace: a foundation repository with no build that holds cross-repo PRDs, plans and rules" },
        "name": { "type": ["string", "null"], "default": null, "description": "How plans refer to this repository; null: the folder name" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read only when repo.kind is workspace",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": ["string", "null"], "description": "Local checkout relative to the workspace when it is nested here; null when it is not" },
              "url": { "type": ["string", "null"], "description": "Remote URL, used when there is no local checkout" }
            }
          }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["app", "workspace"], "default": "app", "description": "app: a repository that builds and ships code; workspace: a foundation repository with no build that holds cross-repo PRDs, plans and rules" },
        "name": { "type": ["string", "null"], "default": null, "description": "How plans refer to this repository; null: the folder name" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read only when repo.kind is workspace",
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "path": { "type": ["string", "null"], "description": "Local checkout relative to the workspace when it is nested here; null when it is not" },
              "url": { "type": ["string", "null"], "description": "Remote URL, used when there is no local checkout" }
            }
          }
        }
      }
    },
    "artefacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prd_dir": { "type": "string", "default": "prds" },
        "prd_layout": { "type": "string", "enum": ["folder", "flat"], "default": "folder", "description": "folder: prds/<id>/prd.md with revisions and mockups inside; flat: prds/<id>.md with revisions beside it" },
        "plan_dir": { "type": "string", "default": "plans" },
        "investigations_dir": { "type": "string", "default": "investigations" },
        "mockup_dir": { "type": ["string", "null"], "default": null, "description": "null: mockups/ inside the PRD folder (folder layout) or prds/mockups/<id>/ (flat)" }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prd": {
          "type": "string",
          "default": "{slug}",
          "description": "Tokens: {slug} from the title, {tracker} the tracker item number (created first), {seq:N} zero-padded counter scanned from prd_dir, {date} YYYYMMDD, {initials} from git user.name. The id must be filename-safe."
        },
        "revision": { "type": "string", "default": "{prd}-R{seq:2}" }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["github", "ado", "none"], "default": "none" },
        "issue_ref": { "type": "string", "default": "#{n}" },
        "org": { "type": "string" },
        "project": { "type": "string" }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prd": { "type": "string", "default": "docs/{id}" },
        "work": { "type": "string", "default": "feat/{id}" },
        "fix": { "type": "string", "default": "fix/{id}" }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"] },
        "guide": { "type": ["string", "null"] }
      }
    },
    "placeholder_data": { "type": ["string", "null"] },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": { "type": ["string", "null"] },
        "typecheck": { "type": ["string", "null"] },
        "test": { "type": ["string", "null"] },
        "e2e": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "always_read": { "type": "array", "items": { "type": "string" } },
        "knowledge_index": { "type": "boolean", "default": false }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gotchas_dir": { "type": ["string", "null"] },
        "decisions_dir": { "type": ["string", "null"] }
      }
    }
  }
}
